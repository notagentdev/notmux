  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#616e88", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#a3be8c" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"],
      "settings": { "foreground": "#b48ead" }
    },
    {
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#81a1c1" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.enum", "support.type", "support.class"],
      "settings": { "foreground": "#8fbcbb" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#88c0d0" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#d8dee9" }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#d8dee9" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#bf616a" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#b48ead" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#bf616a" }
    }
  ]
}
