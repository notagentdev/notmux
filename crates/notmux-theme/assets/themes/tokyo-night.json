  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#565f89", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#9ece6a" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"],
      "settings": { "foreground": "#ff9e64" }
    },
    {
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#bb9af7" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.enum", "support.type", "support.class"],
      "settings": { "foreground": "#2ac3de" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#7aa2f8" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#e0af68" }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#c0caf5" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#f7768e" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#bb9af7" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#f7768e" }
    }
  ]
}
