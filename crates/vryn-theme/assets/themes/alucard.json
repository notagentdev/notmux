  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6C664B", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#14710A" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"],
      "settings": { "foreground": "#A34D14" }
    },
    {
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#A3144D" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.enum", "support.type", "support.class"],
      "settings": { "foreground": "#846E15" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#644AC9" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#A34D14", "fontStyle": "italic" }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#1F1F1F" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#A3144D" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#14710A" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#CB3A2A" }
    }
  ]
}
